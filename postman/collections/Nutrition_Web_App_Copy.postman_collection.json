    {
      "name": "Register",
      "event": [
        {
          "id": "8e6b46da-8d95-4079-8e9c-e5c1bc02d053",
          "listen": "test",
          "script": {
            "id": "f2d93e3b-ac4a-44a8-bb02-260176aff2b5",
            "exec": [
              "// Register",
              "pm.test(\"Status code is 201 or 200\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "",
              "pm.test(\"Response is JSON\", function () {",
              "    pm.response.to.have.header(\"Content-Type\");",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "try {",
              "    var jsonData = pm.response.json();",
              "    pm.test(\"Response has user fields\", function () {",
              "        pm.expect(jsonData).to.have.property(\"id\");",
              "        pm.expect(jsonData).to.have.property(\"email\");",
              "    });",
              "} catch (e) {",
              "    pm.test(\"Response is valid JSON\", function () {",
              "        pm.expect.fail(\"Response is not valid JSON\");",
              "    });",
              "}",
              "",
              "pm.test(\"No error in response\", function () {",
              "    var jsonData;",
              "    try { jsonData = pm.response.json(); } catch (e) { return; }",
              "    pm.expect(jsonData).to.not.have.property(\"error\");",
              "});"
            ],
            "type": "text/javascript"
          }
